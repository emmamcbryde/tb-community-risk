{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:country_tb:review_ui:1.0.0",
  "title": "Isolated scientific-review UI envelopes; production unavailable",
  "$defs": {
    "artifact": {"type":"object","required":["schema_id","profile_hash","production_available"],"properties":{"profile_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"production_available":{"const":false},"externally_validated":{"const":false}}},
    "configuration": {"type":"object","required":["schema_id","application_version","population","tbi","risk","association","natural","diagnostic","display"],"properties":{"schema_id":{"const":"country_tb.review_ui_configuration.v1"},"application_version":{"const":"country_tb_review_ui_1.0.0"},"production_available":{"const":false},"population":{"type":"object","required":["country","scope","source","baseline_year","subgroups"],"properties":{"baseline_year":{"const":2024}}},"diagnostic":{"type":"object","required":["enabled","bundle","lower","upper","grid_intervals"],"properties":{"enabled":{"type":"boolean"},"grid_intervals":{"type":"integer","minimum":64,"maximum":512}}}}},
    "baseline": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["subgroups","rows","summary","declared_population","unresolved_subgroups","native_mixture","age_sex_reconciliation_residuals"],"properties":{"schema_id":{"const":"country_tb.review_ui_baseline_result.v1"}}},
    "risk": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["subgroups","rows","declared_population","unresolved_subgroups","native_mixture"],"properties":{"schema_id":{"const":"country_tb.review_ui_risk_result.v1"}}},
    "forward": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["status","instantaneous","prospective","scenarios","unresolved_population","numerical_policy","assumptions"],"properties":{"schema_id":{"const":"country_tb.review_ui_forward_result.v1"},"status":{"enum":["calculation_blocked","diagnostic_sensitivity","partial_diagnostic_sensitivity"]}}},
    "run": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["application_version","configuration_hash","configuration","context","baseline","risk_allocation","projection","provenance"],"properties":{"schema_id":{"const":"country_tb.review_ui_run.v1"},"configuration":{"$ref":"#/$defs/configuration"},"baseline":{"$ref":"#/$defs/baseline"},"risk_allocation":{"$ref":"#/$defs/risk"},"projection":{"$ref":"#/$defs/forward"}}},
    "gate_panel": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["rows","enabled","prefit_allowed","public_status","review_binding_hash"],"properties":{"schema_id":{"const":"country_tb.review_ui_gate_panel.v1"},"prefit_allowed":{"const":false},"public_status":{"const":"unavailable_pending_progression_and_risk_forward_operator"},"rows":{"type":"array","minItems":15,"maxItems":15,"items":{"required":["item","status","reason"],"properties":{"status":{"enum":["Resolved and reviewed","Selected for sensitivity only","Unresolved","Incompatible","Blocked"]}}}}}},
    "numerical_gate": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["configuration_hash","passed","identifiability","integration_refinement_difference","reviewed_allowed_difference","scientific_prefit_gate","fitting_accepted"],"properties":{"schema_id":{"const":"country_tb.review_ui_numerical_gate.v1"},"passed":{"type":"boolean"},"fitting_accepted":{"const":false}}},
    "diagnostic_run": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["configuration_hash","configuration","context","diagnostic","review_bundle","gate","numerical_gate","declared_population","diagnostic_population","excluded_population","public_status"],"properties":{"schema_id":{"const":"country_tb.review_ui_diagnostic_run.v1"},"public_status":{"const":"unavailable_pending_progression_and_risk_forward_operator"},"classification":{"const":"diagnostic_only_not_approved_for_production"}}},
    "export": {"allOf":[{"$ref":"#/$defs/artifact"}],"required":["configuration","run","scientific_approval","gate_outcomes","precision"],"properties":{"schema_id":{"const":"country_tb.review_ui_export.v1"},"scientific_approval":{"const":"pending"}}}
  },
  "oneOf": [{"$ref":"#/$defs/configuration"},{"$ref":"#/$defs/baseline"},{"$ref":"#/$defs/risk"},{"$ref":"#/$defs/forward"},{"$ref":"#/$defs/run"},{"$ref":"#/$defs/gate_panel"},{"$ref":"#/$defs/numerical_gate"},{"$ref":"#/$defs/diagnostic_run"},{"$ref":"#/$defs/export"}]
}
