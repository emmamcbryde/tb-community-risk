          "type": "string",
          "minLength": 1
        },
        "association": {
          "type": [
            "object",
            "null"
          ]
        },
        "compressed_cells": {
          "type": "array",
          "maxItems": 144,
          "items": {
            "type": "object",
            "required": [
              "factor_count",
              "any_non_recency_risk_factor",
              "effective_rr",
              "probability",
              "expected_population",
              "tbi_state_counts"
            ],
            "properties": {
              "factor_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "any_non_recency_risk_factor": {
                "type": "boolean"
              },
              "effective_rr": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/amount"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "probability": {
                "$ref": "#/$defs/amount"
              },
              "expected_population": {
                "$ref": "#/$defs/amount"
              },
              "tbi_state_counts": {
                "$ref": "#/$defs/state_counts"
              }
            }
          }
        },
        "factor_marginals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "complete_expected_stratification": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "subgroup_id",
        "geography_id",
        "baseline_year",
        "age_lower",
