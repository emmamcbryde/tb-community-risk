{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:country_tb:risk_allocation:1.0.0",
  "title": "Isolated progression-risk population allocation contracts",
  "description": "Pure APIs additionally enforce exact arithmetic, definition/age/review compatibility, feasible coupling and marginal preservation.",
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "schema_id",
        "contract_version",
        "implementation_version",
        "purpose",
        "numerical_policy",
        "profile_hash"
      ],
      "properties": {
        "schema_id": {
          "enum": [
            "country_tb.baseline_population_risk_allocation.v1",
            "country_tb.multimorbidity_progression_policy.v1",
            "country_tb.population_risk_allocation_mixture.v1",
            "country_tb.progression_risk_factor_catalog.v1",
            "country_tb.progression_risk_factor_record.v1",
            "country_tb.risk_allocation_diagnostic_set.v1",
            "country_tb.risk_allocation_export_receipt.v1",
            "country_tb.risk_factor_definition_mapping.v1",
            "country_tb.risk_factor_overlap_policy.v1",
            "country_tb.risk_factor_prevalence_profile.v1",
            "country_tb.tbi_any_risk_association.v1"
          ]
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "implementation_version": {
          "const": "country_tb_risk_allocation_1.0.0"
        },
        "purpose": {
          "const": "planning_and_sequencing_not_denying_care"
        },
        "numerical_policy": {
          "const": "exact_rational_probabilities_and_expected_counts_decimal80_display"
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt": {
          "type": "object"
        },
        "display": {
          "type": "object"
        }
      }
    },
    "amount": {
      "type": "object",
      "required": [
        "value",
        "exact"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "exact": {
          "type": "object",
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "state_counts": {
      "type": "object",
      "properties": {
        "any_tbi": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "never_infected": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "recent": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_only": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "prior_remote_plus_recent": {
          "anyOf": [
            {
              "$ref": "#/$defs/amount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "any_tbi",
        "never_infected",
        "recent",
        "remote_only",
        "prior_remote_plus_recent"
      ],
      "additionalProperties": false
    },
    "prevalence_record": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "factor_id": {
          "enum": [
            "cxr_granuloma",
            "heavy_smoking",
            "underweight",
            "diabetes",
            "tnf_inhibitor",
            "cxr_fibronodular",
            "head_neck_carcinoma",
            "haemodialysis",
            "silicosis",
            "hiv",
            "transplant_immunosuppression"
          ]
        },
        "state": {
          "enum": [
            "value",
            "missing",
            "not_applicable",
            "excluded",
            "not_reviewed",
            "unavailable_due_to_definition_mismatch"
          ]
        },
        "effective_state": {
          "enum": [
            "value",
            "missing",
            "not_applicable",
            "excluded",
            "not_reviewed",
            "unavailable_due_to_definition_mismatch"
          ]
        },
        "prevalence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "enum": [
            "female",
            "male",
            "both"
          ]
        },
        "age_lower": {
          "type": "integer",
          "minimum": 0
        },
        "age_upper_exclusive": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "allocation_policy": {
          "enum": [
            "direct_age_sex_values_v1",
            "piecewise_constant_within_supplied_band_v1",
            "uniform_within_eligible_strata_v1",
            "reviewed_age_sex_pattern_scaled_to_total_v1"
          ]
        },
        "supplied_exposure_definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalogue_definition": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_record_hash": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_status": {
          "enum": [
            "compatible_exact_definition",
            "reviewed_mapping",
            "definition_mismatch"
          ]
        },
        "mapping_policy": {
          "type": "string",
          "minLength": 1
        },
        "definition_mapping": {
          "anyOf": [
            {
              "$ref": "#"
            },
            {
              "type": "null"
            }
          ]
        },
        "pattern": {
          "type": [
            "object",
            "null"
          ]
        },
        "review": {
          "type": "object",
          "required": [
            "status",
            "source_id",
            "rationale"
          ],
          "properties": {
            "status": {
              "enum": [
                "reviewed",
                "not_reviewed"
