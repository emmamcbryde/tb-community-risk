        "record_id",
        "factor_id",
        "state",
        "effective_state",
        "prevalence",
        "sex",
        "age_lower",
        "age_upper_exclusive",
        "allocation_policy",
        "supplied_exposure_definition",
        "catalogue_definition",
        "compatibility_status",
        "mapping_policy",
        "review",
        "source",
        "provenance",
        "definition_mapping",
        "pattern",
        "reason",
        "warnings"
      ]
    },
    "allocation_row": {
      "type": "object",
      "properties": {
