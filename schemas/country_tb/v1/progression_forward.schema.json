{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:country_tb:progression_forward:1.0.0",
  "title": "Isolated active-TB forward progression contracts; inverse calibration blocked",
  "description": "Pure constructors additionally validate numerical semantics, evidence scope, monotonic hazards, overlap, population coverage and scientific hashes.",
  "$defs": {
    "curve": {
      "type": "object",
      "required": [
        "status",
        "risk_interpretation",
        "knots",
        "segments",
        "tail",
        "tail_parameters",
        "source",
        "provenance",
        "review"
      ],
      "properties": {
        "status": {
          "enum": [
            "reviewed_external",
            "diagnostic_synthetic",
            "diagnostic_adult_surrogate"
          ]
        },
        "risk_interpretation": {
          "enum": [
            "net_risk_without_competing_mortality_v1",
            "diagnostic_cumulative_risk_surrogate_pending_cause_specific_review_v1"
          ]
        },
        "knots": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "time_years",
              "cumulative_risk",
              "cumulative_hazard"
            ],
            "properties": {
              "time_years": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "cumulative_risk": {
                "type": "string",
                "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
              },
              "cumulative_hazard": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "additionalProperties": false
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "hazard_per_year"
            ],
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "end": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "hazard_per_year": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            },
            "additionalProperties": false
          }
        },
        "tail": {
          "enum": [
            "no_extrapolation_v1",
            "constant_final_segment_hazard_v1",
            "declining_to_remote_plateau_v1",
            "fixed_remote_hazard_v1"
          ]
        },
        "tail_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          }
        },
        "source": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        },
        "review": {
          "type": "object"
        },
        "interpolation": {
          "type": "string"
        },
        "tail_scientific_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cohort_row": {
      "type": "object",
      "required": [
        "cohort_id",
        "subgroup_id",
        "sex",
        "population",
        "age",
        "baseline_tbi_state",
        "tau",
        "effective_rr",
        "responsibility_weights",
        "prior_remote_plus_recent_fraction",
        "baseline_active_tb_population",
        "effect_status",
        "pediatric_effect_approved",
        "effect_age_applicability",
        "unresolved_reasons"
      ],
      "properties": {
        "cohort_id": {
          "type": "string",
          "minLength": 1
        },
        "subgroup_id": {
          "type": "string",
          "minLength": 1
        },
        "sex": {
          "enum": [
            "female",
            "male"
          ]
        },
        "population": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "age": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_tbi_state": {
          "enum": [
            "never_infected",
            "recent",
            "remote_only",
            "unresolved"
          ]
        },
        "tau": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_rr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "responsibility_weights": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
          }
        },
        "prior_remote_plus_recent_fraction": {
          "type": "string",
          "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"
        },
        "baseline_active_tb_population": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "effect_status": {
          "type": "string"
        },
        "pediatric_effect_approved": {
          "type": "boolean"
        },
        "effect_age_applicability": {
          "type": "object",
          "required": [
            "age_lower",
            "age_upper_exclusive",
            "policy"
          ],
          "properties": {
            "age_lower": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "age_upper_exclusive": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "unresolved_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "age_at_most_recent_infection": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_age_lower": {
          "type": "integer",
          "minimum": 0
        },
        "source_age_upper_exclusive": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "projection_row": {
      "type": "object",
      "required": [
