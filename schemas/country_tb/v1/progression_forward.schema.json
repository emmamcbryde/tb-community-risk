            "type": "string"
          }
        },
        "expected_cases": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cumulative_risk": {
          "anyOf": [
