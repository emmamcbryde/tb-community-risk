        },
        "population_accounting_residual": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "prior_remote_plus_recent_baseline_subset_population": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "additionalProperties": false
    }
